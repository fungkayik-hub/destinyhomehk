# ============================================================
# AI 命盘分析 — 二选一（优先 Microsoft Azure OpenAI）
# ============================================================

# 【推荐】Microsoft Azure OpenAI
# Copilot 背后同款 GPT 引擎，经 Microsoft 云端
# 申请：https://portal.azure.com → 创建「Azure OpenAI」资源
# 部署模型（如 gpt-4o-mini）后填入以下变量：
#
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://你的资源名.openai.azure.com
AZURE_OPENAI_API_KEY=你的azure密钥
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# 【备选】OpenAI 直连
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# 注意：Copilot 手机 App / copilot.microsoft.com 无法直接接入网站
# 必须用 Azure OpenAI API 或 OpenAI API

# Google Analytics 4（search.google.com/analytics → Admin → Data Streams → Measurement ID）
# 設好後執行：node scripts/validate-ga-id.mjs G-XXXXXXXXXX（無效 ID 會 HTTP 404）
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cloudflare Turnstile（預約表單防 spam，可選）
# https://dash.cloudflare.com → Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=你的site_key
# TURNSTILE_SECRET_KEY=你的secret_key

# ============================================================
# SEO / Google 商家 / 本地搜尋
# ============================================================
# 正式網域（轉 DNS 後填；Vercel Production 建議設）
NEXT_PUBLIC_SITE_URL=https://www.destinyhomehk.com

# Google Search Console 驗證碼（search.google.com/search-console）
GOOGLE_SITE_VERIFICATION=你的驗證碼

# Google Business Profile「分享商家」連結 → 網站會顯示「Google 商家」按鈕
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://g.page/你的商家連結

# 留評價直連（GBP → 邀請評論 → 複製連結，可選）
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/你的留評價連結

# 可選：YouTube 頻道（用於結構化資料 sameAs）
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@你的頻道

# Vercel Cron 密鑰（每日 00:01 HKT 自動更新流日；Vercel → Settings → Cron Jobs 會自動帶 Bearer）
# CRON_SECRET=隨機長字串

# ============================================================
# 網上預約 — Resend 電郵通知 + Vercel Postgres（正式環境建議）
# ============================================================
# Resend API Key：https://resend.com/api-keys
RESEND_API_KEY=re_你的密鑰

# 預約通知收件人（預設 fungkayik@gmail.com）
BOOKING_NOTIFY_EMAIL=fungkayik@gmail.com

# 寄件人（正式上線請用已驗證域名，如 bookings@destinyhomehk.com）
# BOOKING_FROM_EMAIL=Destiny Home <bookings@destinyhomehk.com>

# Vercel Postgres（Storage → Postgres → 連接後自動有 POSTGRES_URL）
# 本地開發唔設 POSTGRES_URL 會用 data/bookings.json 儲存

# Instagram Graph API（商業帳戶，可選 — 用於 npm run import-instagram）
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# ============================================================
# 網上預約（/book）
# ============================================================
# Resend — 預約成功後 email 通知（https://resend.com）
RESEND_API_KEY=re_你的密鑰
BOOKING_NOTIFY_EMAIL=fungkayik@gmail.com
# 正式上線後改用已驗證網域，例如：Destiny Home <bookings@destinyhomehk.com>
# BOOKING_FROM_EMAIL=Destiny Home <bookings@destinyhomehk.com>

# 正式環境必須設定資料庫（Vercel → Storage → Postgres / Neon）
# 本機開發唔設 POSTGRES_URL 會用 data/bookings.json
# POSTGRES_URL=postgres://...

# ============================================================
# 網上付款 — Stripe（連接香港銀行戶口收款）
# ============================================================
# 1. https://dashboard.stripe.com/register 開香港商戶
# 2. Settings → Payouts → 加入香港銀行戶口
# 3. Developers → API keys
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# 4. Developers → Webhooks → https://www.destinyhomehk.com/api/booking/webhook
#    Event: checkout.session.completed
#    （預約付款 + 小師傅 AI 命書 共用同一 webhook）
# STRIPE_WEBHOOK_SECRET=whsec_...
